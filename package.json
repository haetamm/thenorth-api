{
  "name": "project-ts-express",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "tsc": "rm -rf build/ && tsc",
    "ts": "rm -rf build/ && tsc -w",
    "dev": "ts-node-dev --poll --respawn src/index.ts",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:prod": "npx sequelize-cli db:migrate --config build/config/database.js --env production --migrations-path build/db/migrations",
    "seed:prod": "npx sequelize-cli db:seed:all --config build/config/database.js --env production --seeders-path build/db/seeders",
    "migrate-undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.14.194",
    "typescript": "^5.0.4",
    "@types/node": "25.2.3",
    "ts-node-dev": "2.0.0",

    "@eslint/js": "^9",
    "eslint": "^9",
    "eslint-plugin-prettier": "^5",
    "globals": "^15",
    "prettier": "^3",
    "typescript-eslint": "^8"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "pg": "^8.11.5",
    "sequelize": "^6.31.1",
    "sequelize-cli": "^6.6.0",
    "uuid": "^9.0.0"
  }
}
